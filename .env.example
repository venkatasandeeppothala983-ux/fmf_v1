# Copy this file to .env and replace every placeholder before using Docker Compose.
MYSQL_DATABASE=findmyfaculty
MYSQL_USER=findmyfaculty
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
MYSQL_PORT=3306

# Java application configuration (when running the app on the host)
DB_URL=jdbc:mysql://localhost:3306/findmyfaculty?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=findmyfaculty
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_USERNAME=portal-admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
SESSION_COOKIE_SECURE=false

# Optional demo accounts for the isolated preview profile. Use only synthetic usernames/passwords.
PREVIEW_STUDENT_USERNAME=demo-student
PREVIEW_STUDENT_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
PREVIEW_FACULTY_USERNAME=demo-faculty
PREVIEW_FACULTY_PASSWORD=REPLACE_WITH_A_DIFFERENT_PASSWORD_AT_LEAST_12_CHARACTERS

# Comma-separated browser origins allowed for cookie-based APIs
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://*.e2b.app,https://*.trycloudflare.com
